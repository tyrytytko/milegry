{
  "name": "milegry",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Miłe Gry — spokojne gry przeglądarkowe dla dzieci 3–5 lat",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/postbuild.mjs",
